{
  "name": "hungtran-pm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "migrate:programs": "node scripts/migrate-program-ids.js",
    "migrate:programs:dry": "node scripts/migrate-program-ids.js --dry-run",
    "migrate:lessons": "node scripts/migrate-lessons-subcollection.js",
    "migrate:lessons:dry": "node scripts/migrate-lessons-subcollection.js --dry-run",
    "migrate:lessons:html": "node scripts/migrate-lessons-to-html.js",
    "migrate:lessons:html:dry": "node scripts/migrate-lessons-to-html.js --dry-run",
    "migrate:lessons:html:apply": "node scripts/migrate-lessons-to-html.js --apply",
    "migrate:lessons:html:rollback": "node scripts/migrate-lessons-to-html.js --rollback",
    "migrate:lessons:html:rollback:apply": "node scripts/migrate-lessons-to-html.js --rollback --apply",
    "migrate:lessons:presentation": "node scripts/migrate-lesson-presentation.js",
    "migrate:lessons:presentation:apply": "node scripts/migrate-lesson-presentation.js --apply",
    "migrate:lessons:presentation:rollback": "node scripts/migrate-lesson-presentation.js --rollback",
    "migrate:lessons:presentation:rollback:apply": "node scripts/migrate-lesson-presentation.js --rollback --apply",
    "migrate:feedback-index": "node scripts/migrate-student-feedback-index.js",
    "migrate:feedback-index:dry": "node scripts/migrate-student-feedback-index.js --dry-run",
    "audit:curriculum": "node scripts/audit-curriculum-collections.js",
    "audit:security": "npm run audit:security:full",
    "audit:security:full": "npm audit",
    "audit:security:gate": "npm audit --audit-level=high",
    "ci": "npm run lint && npm test && npm run test:migration && npm run test:rules && npm run build && npm run audit:security:gate",
    "lint": "eslint . --max-warnings 9999",
    "format": "prettier --check \"src/**/*.{js,jsx}\" \"firestore-rules/**/*.js\"",
    "format:write": "prettier --write \"src/**/*.{js,jsx}\" \"firestore-rules/**/*.js\"",
    "verify": "npm test && npm run test:migration && npm run build",
    "inspect:lessons": "node scripts/inspect-program-lessons.js",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "test": "vitest run",
    "test:migration": "node --test scripts/lesson-html-migration-lib.test.js scripts/lesson-presentation-migration-lib.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.js\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.10",
    "dompurify": "^3.4.14",
    "firebase": "^12.15.0",
    "lucide-react": "^1.22.0",
    "marked": "^18.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@sentry/react": "^9.46.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.22.3",
    "globals": "^16.5.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^28.1.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
